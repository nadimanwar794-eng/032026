{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/iic-study-app-replit",
    "build": "npm run build --workspace=@workspace/iic-study-app-replit",
    "serve": "npm run serve --workspace=@workspace/iic-study-app-replit",
    "lint": "tsc -p ./artifacts/iic-study-app-replit/tsconfig.json --noEmit",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}
