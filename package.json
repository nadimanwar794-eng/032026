{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/iic-study-app-replit",
    "artifacts/api-server",
    "artifacts/mockup-sandbox",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@workspace/iic-study-app-replit",
    "build": "npm run build --workspace=@workspace/iic-study-app-replit",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs && npm run typecheck --workspace=@workspace/iic-study-app-replit",
    "lint": "tsc --build"
  },
  "devDependencies": {
    "katex": "^0.16.22",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "vite": "^7.3.2"
  }
}
