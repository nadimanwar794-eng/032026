rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to get the current user's role safely from the 'users' collection
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'STUDENT');
    }

    // Helper function to check if the user is an admin or sub-admin
    function isAdminOrSubAdmin() {
      return isSignedIn() && (getUserRole() == 'ADMIN' || getUserRole() == 'SUB_ADMIN');
    }

    // Default rule: Allow reading everything if authenticated. Write explicitly denied by default unless specified.
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdminOrSubAdmin();
    }

    // ------------------------------------------------------------------------
    // User Data Collections
    // ------------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isSignedIn();
      // Allow user to create or update their own document.
      // Use .get('role', '') to prevent throwing an error if role is absent
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.get('role', '') != 'ADMIN'
                    && request.resource.data.get('role', '') != 'SUB_ADMIN'
                    && request.resource.data.get('totalScore', 0) <= 1000000;
      allow update: if isSignedIn() && request.auth.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
                        || (request.resource.data.get('role', '') != 'ADMIN' && request.resource.data.get('role', '') != 'SUB_ADMIN'))
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalScore'])
                        || (request.resource.data.get('totalScore', 0) <= resource.data.get('totalScore', 0) + 1000000));
      allow delete: if isAdminOrSubAdmin();

      // Allow writing to nested user history and test_results collections
      match /history/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /test_results/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /routine_lessons/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
      match /revision_lessons/{docId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }

    match /user_data/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Coin Wallet (Protects against hack injections)
    match /user_coins/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.get('coins', 0) <= 1000000;

      allow update: if isSignedIn() && request.auth.uid == userId
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['coins'])
                      || (request.resource.data.get('coins', 0) <= resource.data.get('coins', 0) + 1000000)
                    );
    }

    match /user_animations/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /user_themes/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    match /suggestion_leaderboard/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.get('totalCoins', 0) <= 1000000;
      allow update: if isSignedIn() && request.auth.uid == userId
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalCoins'])
                      || (request.resource.data.get('totalCoins', 0) <= resource.data.get('totalCoins', 0) + 1000000)
                    );
    }

    // ------------------------------------------------------------------------
    // Public / Shared Write Collections
    // ------------------------------------------------------------------------

    match /demand_requests/{requestId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == request.auth.uid);
      allow update: if isSignedIn() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['userId']));
    }

    match /public_activity/{activityId} {
      allow read: if isSignedIn();
      // Ensure users cannot spoof the userId in activity feeds
      allow create: if isSignedIn() && (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == request.auth.uid);
    }

    match /universal_analysis_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == request.auth.uid);
    }

    match /ai_interactions/{interactionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == request.auth.uid);
    }

    match /app_feedback/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (!request.resource.data.keys().hasAny(['userId']) || request.resource.data.userId == request.auth.uid);
    }

    match /daily_challenge_leaderboard/{dateKey}/scores/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    // ------------------------------------------------------------------------
    // Content and System (Admin Only Write)
    // ------------------------------------------------------------------------

    match /admin_secure/{docId} {
      allow read, write: if isAdminOrSubAdmin();
    }
    match /admin_settings/{docId} {
      allow read, write: if isAdminOrSubAdmin();
    }
    match /admin_stats/{docId} {
      allow read, write: if isAdminOrSubAdmin();
    }
    match /config/{docId} {
      allow read, write: if isAdminOrSubAdmin();
    }
    match /content_data/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrSubAdmin();
    }
    match /compre_notes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrSubAdmin();
    }
    match /custom_syllabus/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrSubAdmin();
    }
    match /homework_entries/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrSubAdmin();
    }
    match /lucent_entries/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrSubAdmin();
    }
    match /mcq_lessons/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrSubAdmin();
    }
    match /published_animations/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrSubAdmin();
    }
    match /published_themes/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdminOrSubAdmin();
    }
    match /trash_homework_entries/{docId} {
      allow read, write: if isAdminOrSubAdmin();
    }
    match /redeem_codes/{docId} {
      allow read: if isSignedIn();
      // Users must be able to write to update the used count/claimed arrays
      allow write: if isSignedIn();
    }
    match /trash_lucent_entries/{docId} {
      allow read, write: if isAdminOrSubAdmin();
    }

  }
}
