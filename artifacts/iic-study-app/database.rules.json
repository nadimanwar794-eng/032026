{
  "rules": {
    // Default Rule: Require authentication
    ".read": "auth != null",
    ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')",

    "users": {
      "$uid": {
        // Users can read/write their own node, or Admins can read/write everything
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')",

        "role": {
           // Allow updating if it remains unchanged OR if the user is an admin
           ".validate": "newData.val() === data.val() || root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN'"
        },

        // Prevent hacking huge score/credit/coin values via client-side manipulation
        "totalScore": {
           ".validate": "!data.exists() || !newData.isNumber() || !data.isNumber() || (newData.val() <= data.val() + 1000000)"
        },
        "credits": {
           ".validate": "!data.exists() || !newData.isNumber() || !data.isNumber() || (newData.val() <= data.val() + 1000000)"
        },
        "giftedCredits": {
           ".validate": "!data.exists() || !newData.isNumber() || !data.isNumber() || (newData.val() <= data.val() + 1000000)"
        },
        "bonusCredits": {
           ".validate": "!data.exists() || !newData.isNumber() || !data.isNumber() || (newData.val() <= data.val() + 1000000)"
        }
      }
    },

    "chat": {
      "dm": {
         "$dmUserId": {
           // Ensure only the intended DM recipient or an Admin can write here
           ".write": "auth != null && (auth.uid === $dmUserId || root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')",
           "$msgId": {
             // Ensure sender identity is genuine
             ".validate": "!newData.hasChild('userId') || newData.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN'"
           }
         }
      },
      "universal": {
         ".write": "auth != null",
         "$msgId": {
           // Ensure sender identity is genuine in Universal Chat
           ".validate": "!newData.hasChild('userId') || newData.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN'"
         }
      }
    },

    "suggestions": {
       ".write": "auth != null",
       "$suggestionId": {
         // Ensure submitter identity is not spoofed
         ".validate": "!newData.hasChild('uid') || newData.child('uid').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN'"
       }
    },

    "demand_requests": {
       ".write": "auth != null",
       "$requestId": {
         ".validate": "!newData.hasChild('userId') || newData.child('userId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'ADMIN'"
       }
    },

    "public_activity": {
       ".write": "auth != null",
       "$activityId": {
         ".validate": "!newData.hasChild('userId') || newData.child('userId').val() === auth.uid"
       }
    },

    "universal_analysis_logs": {
       ".write": "auth != null",
       "$logId": {
         ".validate": "!newData.hasChild('userId') || newData.child('userId').val() === auth.uid"
       }
    },

    "ai_interactions": {
       ".write": "auth != null",
       "$interactionId": {
         ".validate": "!newData.hasChild('userId') || newData.child('userId').val() === auth.uid"
       }
    },

    // ------------------------------------------------------------------------
    // Core Admin-only write paths (Reads allowed globally by default rule)
    // ------------------------------------------------------------------------
    "content_data": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "mcq_lessons": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "system_settings": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "content_index": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "content_links": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "custom_syllabus": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "homework_entries": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "homework_index": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "lucent_entries": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "lucent_index": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "compre_notes": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "compare_analytics": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "admin_highlights": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "trash": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    },
    "redeem_codes": {
       ".read": "auth != null",
       // Users must be able to run transactions to increment usedCount and append to redeemedBy
       ".write": "auth != null"
    },
    "__backup__": {
       ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'ADMIN' || root.child('users').child(auth.uid).child('role').val() === 'SUB_ADMIN')"
    }
  }
}
